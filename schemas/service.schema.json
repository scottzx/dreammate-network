{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreammate.work/schemas/service.schema.json",
  "title": "DreamMate Service",
  "description": "Node 上的一组能力聚合。三层结构是 Node → Service → Capability / Resource，不要把 Capability 扁平铺到 Node 上。Agent Runtime 是 Service 的一种特殊 kind。",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Service 在所属 Node 内唯一。",
      "minLength": 1,
      "examples": [
        "session-registry",
        "reminders",
        "recordings",
        "agent-runtime"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "人类可读名称，可省略。"
    },
    "kind": {
      "type": "string",
      "description": "Service 类型。generic 之外的几种在传输层保留原生协议（见 protocol.md §5），不强行塞进 /capabilities/:name/invoke。",
      "enum": [
        "generic",
        "agent_runtime",
        "session_registry",
        "resource_provider",
        "mcp"
      ],
      "default": "generic"
    },
    "capabilities": {
      "type": "array",
      "description": "@deprecated 历史遗留字段，新服务请优先使用 methods 与 skills。可以为空数组（纯 Resource Provider）。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "methods": {
      "type": "object",
      "description": "该 Service 提供的可调用 RPC 方法集合，明确参数与返回值契约。",
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "该方法的业务功能描述。"
          },
          "parameters": {
            "type": "object",
            "description": "入参 JSON Schema 定义（必须是 object 结构）。"
          },
          "returns": {
            "type": "object",
            "description": "返回值结构说明。"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "description": "该 Service 配套的领域业务 SOP 与操作指南（Markdown 格式）。",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "description",
          "sop"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "技能唯一标识名。"
          },
          "description": {
            "type": "string",
            "description": "技能触发场景说明。"
          },
          "sop": {
            "type": "string",
            "description": "包含步骤指导的完整 Markdown SOP 正文。"
          },
          "has_package": {
            "type": "boolean",
            "description": "是否具备可供跨节点打包下载的完整本地技能包。"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "该 Service 拥有什么（可选，声明资源 URI 的 scheme 而非逐条枚举）。Capability=能做什么，Resource=拥有什么，两者不要混：检索侧走 resource.search/read，调度侧走 capability.invoke。",
      "items": {
        "type": "object",
        "required": [
          "scheme"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "description": "资源 URI 的 scheme。",
            "examples": [
              "recording",
              "transcript",
              "speaker",
              "session"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "access": {
      "type": "array",
      "description": "怎么访问这个 Service。传输方式只出现在这里，绝不进数据模型——不存在所谓 MCP Capability / CLI Capability。同一组能力可以同时有多种 access，调用方不必关心底层是谁。包装优先级 MCP > CLI > HTTP，但第一版不做自动 fallback 编排，手工声明即可。",
      "items": {
        "$ref": "#/$defs/access"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Service 级自由扩展字段。协议不解释其内容。",
      "additionalProperties": true
    },
    "reachability": {
      "type": "string",
      "enum": [
        "localhost",
        "network"
      ],
      "description": "这个 Service 能被谁连上。localhost=只监听回环，外部节点发现得了但连不上；network=监听 0.0.0.0 或 tailnet 地址，外部可直连。node agent 如实转述服务自己的声明，不做代理——调用方看到 localhost 就知道不用白跑一趟。省略时按 network 理解。"
    },
    "port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 65535,
      "description": "服务实际监听的端口。向本机 node agent 报备时带上，外部才知道该连哪儿；它不必等于 DEFAULT_PORTS 里的默认值。"
    },
    "health": {
      "type": [
        "string",
        "null"
      ],
      "description": "存活探测路径，默认 /health。node agent 定期探它来判断服务死活——注意 Node 在线不代表 Service 在线。"
    }
  },
  "$defs": {
    "access": {
      "type": "object",
      "title": "Access Descriptor",
      "required": [
        "protocol"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "mcp",
            "http",
            "cli",
            "acp"
          ],
          "description": "acp 只用于 kind=agent_runtime 的 Session 控制，与前三者不是一回事：MCP/CLI/HTTP 面向 Capability / Resource，ACP 面向 Agent Runtime / Session Control。"
        },
        "base_url": {
          "type": "string",
          "description": "protocol=http 时的服务基址。",
          "examples": [
            "http://scott-mac:7777/v1"
          ]
        },
        "endpoint": {
          "type": "string",
          "description": "protocol=http 时单个 capability 的相对路由。",
          "examples": [
            "GET /transcripts/:id"
          ]
        },
        "tool": {
          "type": "string",
          "description": "protocol=mcp 时对应的 tool 名。",
          "examples": [
            "transcript_read"
          ]
        },
        "server": {
          "type": "string",
          "description": "protocol=mcp 时的 MCP server 标识。"
        },
        "command": {
          "type": "string",
          "description": "protocol=cli 时的命令。",
          "examples": [
            "tingqi transcript get",
            "1session overview"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "id": "transcripts",
      "capabilities": [
        "transcript.read"
      ],
      "access": [
        {
          "protocol": "mcp",
          "tool": "transcript_read"
        },
        {
          "protocol": "http",
          "endpoint": "GET /transcripts/:id"
        },
        {
          "protocol": "cli",
          "command": "tingqi transcript get"
        }
      ]
    },
    {
      "id": "agent-runtime",
      "kind": "agent_runtime",
      "capabilities": [
        "agent.session.new",
        "agent.session.prompt",
        "agent.session.cancel",
        "agent.session.status",
        "agent.session.resume"
      ],
      "access": [
        {
          "protocol": "acp"
        }
      ]
    }
  ]
}
